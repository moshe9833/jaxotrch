@model ContactForm

<section class="jx-dark jx-section jx-hero jx-hero-sm">
    <partial name="_HeroRing" />
    <div class="container">
        <p class="jx-eyebrow mb-3">Contact</p>
        <h1 class="display-6 fw-semibold text-white mb-3">Get a quote</h1>
        <p class="fs-5" style="max-width: 620px;">Tell us what you're trying to do. We read every message and reply within one business day.</p>
    </div>
</section>

@{
    var faqs = new[]
    {
        ("What does custom software cost?",
         "It depends on scope, and you'll know before we start: every project gets a written, task-by-task estimate. Because we build with AI assistance, our estimates typically come in noticeably lower than traditional agencies — and you can pause, reprioritize, or stop at any point."),
        ("How does AI make development cheaper?",
         "Our engineers use AI coding tools on every project, so the routine work that used to take hours takes minutes. We bill by task, so when a task takes less time, it costs less — the savings are yours automatically. A senior engineer still reviews, tests, and owns every line before it ships."),
        ("Do you only work with businesses in New York?",
         "We're based in Monroe, NY, and most of our work happens remotely — we work with businesses across the United States. Being in the Eastern time zone, you can always reach us during your business day."),
        ("Can you take over software someone else built?",
         "Yes — rescues and takeovers are a regular part of our work: aging systems, struggling stores, and projects a previous vendor left behind. We start by reading the code and telling you honestly what shape it's in."),
        ("How long does a project take?",
         "Small integrations and fixes often ship within days; full systems take weeks rather than months, thanks to AI-assisted development. The written estimate you get up front includes a real timeline, so you know before anything is built.")
    };
    var faqJsonLd = "{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[" +
        string.Join(",", faqs.Select(f =>
            "{\"@type\":\"Question\",\"name\":" + System.Text.Json.JsonSerializer.Serialize(f.Item1) +
            ",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":" + System.Text.Json.JsonSerializer.Serialize(f.Item2) + "}}")) +
        "]}";
}
<script type="application/ld+json">@Html.Raw(faqJsonLd)</script>

<section class="jx-section jx-section-light">
    <div class="container">
        <p class="jx-eyebrow mb-2">Common questions</p>
        <h2>Before you ask</h2>
        <div class="row mt-4 g-4">
            @foreach (var (q, a) in faqs)
            {
                <div class="col-md-6">
                    <h3 class="fs-6 fw-semibold">@q</h3>
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">@a</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="jx-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-7">
                @if (ViewBag.Sent == true)
                {
                    <div class="py-3">
                        <svg width="56" height="56" viewBox="0 0 34 34" aria-hidden="true">
                            <circle cx="17" cy="17" r="12" stroke="#2EE6A8" stroke-width="5" fill="none"/>
                            <path d="M11.5 17 L15.5 21 L23 13" stroke="#0B1E3F" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <h2 class="mt-3 mb-2">Message sent</h2>
                        <p class="jx-lead mb-4">Thanks for reaching out. We'll get back to you within one business day.</p>
                        <a class="btn btn-jaxo-outline" asp-action="Contact">Send another message</a>
                    </div>
                }
                else
                {
                <form class="jx-form" method="post" asp-action="Contact">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Name</label>
                        <input asp-for="Name" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-7 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5 mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone <span class="fw-normal text-muted">(optional)</span></label>
                            <input asp-for="Phone" class="form-control" autocomplete="tel" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Message" class="form-label fw-semibold">Tell us about your project</label>
                        <textarea asp-for="Message" class="form-control" rows="6" placeholder="What are you trying to build or fix? What system are you using today?"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <div class="jx-hp" aria-hidden="true">
                        <label asp-for="Website">Website</label>
                        <input asp-for="Website" tabindex="-1" autocomplete="off" />
                    </div>

                    <button type="submit" class="btn btn-jaxo btn-lg" id="contactSubmit">
                        <svg class="jx-btn-ring jx-spin" width="18" height="18" viewBox="0 0 34 34" aria-hidden="true">
                            <circle cx="17" cy="17" r="12" stroke="rgba(11, 30, 63, 0.3)" stroke-width="5" fill="none"/>
                            <path d="M17 5 A12 12 0 0 1 27.4 11" stroke="#0B1E3F" stroke-width="5" fill="none" stroke-linecap="round"/>
                        </svg><span>Send message</span>
                    </button>
                </form>
                }
            </div>
            <div class="col-lg-4 offset-lg-1">
                <div class="jx-card">
                    <h3 class="mb-3">Prefer to talk?</h3>
                    <p class="mb-2"><a href="tel:+18456626703" class="text-decoration-none fw-semibold">(845) 662-6703</a></p>
                    <p class="mb-2"><a href="mailto:moshe@jaxotech.com" class="text-decoration-none">moshe@jaxotech.com</a></p>
                    <p class="mb-0 text-muted">Monroe, New York</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script>
        var jxForm = document.querySelector(".jx-form");
        if (jxForm) jxForm.addEventListener("submit", function () {
            if (window.jQuery && !jQuery(this).valid()) return;
            var btn = document.getElementById("contactSubmit");
            btn.classList.add("jx-submitting");
            btn.setAttribute("aria-busy", "true");
        });
    </script>
}
