@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var canonicalHost = Config["CanonicalHost"] ?? "jaxotech.com";
    var baseUrl = $"https://{canonicalHost}";
    var requestPath = (Context.Request.Path.Value ?? "/").ToLowerInvariant().TrimEnd('/');
    var canonical = baseUrl + (string.IsNullOrEmpty(requestPath) ? "/" : requestPath);
    var fullTitle = $"{ViewData["Title"]} — Jaxo";
    var metaDescription = ViewData["MetaDescription"] as string
        ?? "Jaxo builds custom software for growing businesses: e-commerce, order management, integrations, and Azure cloud hosting. AI-assisted development means faster delivery at significantly lower cost. Based in Monroe, NY.";
    var orgJsonLd = "{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\"," +
        $"\"name\":\"Jaxo\",\"url\":\"{baseUrl}/\",\"logo\":\"{baseUrl}/img/logo.svg\",\"image\":\"{baseUrl}/img/og-card.png\"," +
        "\"description\":\"Custom software development for growing businesses: e-commerce, business systems, integrations, and Azure cloud hosting. AI-assisted development with senior-engineer review.\"," +
        "\"email\":\"moshe@jaxotech.com\",\"telephone\":\"+1-845-662-6703\"," +
        "\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Monroe\",\"addressRegion\":\"NY\",\"addressCountry\":\"US\"}," +
        "\"areaServed\":[{\"@type\":\"State\",\"name\":\"New York\"},{\"@type\":\"Country\",\"name\":\"United States\"}]}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B1E3F" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    @if (ViewData["Robots"] != null)
    {
        <meta name="robots" content="@ViewData["Robots"]" />
    }
    <link rel="canonical" href="@canonical" />
    <meta property="og:site_name" content="Jaxo" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@baseUrl/img/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="application/ld+json">@Html.Raw(orgJsonLd)</script>
</head>
<body>
    <nav class="jx-nav navbar navbar-expand-md">
        <div class="container">
            <a class="jx-logo navbar-brand" href="/" aria-label="Jaxo home">
                <svg width="96" height="32" viewBox="0 0 132 44" aria-hidden="true" style="overflow: visible;">
                    <text x="4" y="33" font-family="Inter, sans-serif" font-size="30" font-weight="600" fill="#0B1E3F" letter-spacing="-0.5">jax</text>
                    <g class="jx-logo-o">
                        <circle cx="63" cy="23.5" r="9" fill="none" stroke="#0B1E3F" stroke-width="4.2"/>
                        <path d="M63 14.5 A9 9 0 0 1 70.8 19" fill="none" stroke="#2EE6A8" stroke-width="4.2" stroke-linecap="round"/>
                    </g>
                </svg>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-md-center gap-md-2">
                    <li class="nav-item"><a class="nav-link" asp-action="Services">Services</a></li>
                    <li class="nav-item"><a class="nav-link" asp-action="Work">Work</a></li>
                    <li class="nav-item"><a class="nav-link" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link jx-nav-phone" href="tel:+18456626703">(845) 662-6703</a></li>
                    <li class="nav-item ms-md-2 mt-2 mt-md-0">
                        <a class="btn btn-jaxo" asp-action="Contact">Get a quote</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="jx-footer py-4">
        <div class="container">
            <div class="jx-footer-rule" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 34 34">
                    <circle cx="17" cy="17" r="12" stroke="#2E4568" stroke-width="5" fill="none"/>
                    <path d="M17 5 A12 12 0 0 1 27.4 11" stroke="#2EE6A8" stroke-width="5" fill="none" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="text-center text-md-start">
                    <svg width="78" height="26" viewBox="0 0 132 44" aria-label="jaxo">
                        <text x="4" y="33" font-family="Inter, sans-serif" font-size="30" font-weight="600" fill="#FFFFFF" letter-spacing="-0.5">jax</text>
                        <circle cx="63" cy="23.5" r="9" fill="none" stroke="#FFFFFF" stroke-width="4.2"/>
                        <path d="M63 14.5 A9 9 0 0 1 70.8 19" fill="none" stroke="#2EE6A8" stroke-width="4.2" stroke-linecap="round"/>
                    </svg>
                    <div class="jx-footer-tagline mt-1">Plan. Build. Launch. Full circle.</div>
                </div>
                <div class="small text-center">
                    <a href="mailto:moshe@jaxotech.com">moshe@jaxotech.com</a>
                    <span class="mx-2">·</span>
                    <a href="tel:+18456626703">(845) 662-6703</a>
                    <span class="mx-2">·</span>
                    <span>Monroe, NY</span>
                </div>
                <div class="small">
                    <a asp-action="Privacy">Privacy</a>
                    <span class="mx-2">·</span>
                    <a asp-action="Terms">Terms</a>
                    <span class="mx-2">·</span>
                    <span>&copy; @DateTime.Now.Year Jaxo</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
